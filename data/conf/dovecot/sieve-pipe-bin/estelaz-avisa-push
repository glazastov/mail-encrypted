#!/usr/bin/env python3
"""Avisa a plataforma de que uma caixa recebeu e-mail, para ela disparar o push.

Este script roda no caminho de entrega de cada mensagem, chamado pelo Sieve via
`vnd.dovecot.pipe`. Isso impõe três regras das quais nada aqui pode se desviar:

1. **Nunca falhar a entrega.** Sai sempre com 0. Uma exceção não tratada, um
   servidor fora do ar, um DNS mudo — nada disso pode virar e-mail devolvido. Um
   aviso perdido atrasa a notificação; uma entrega perdida perde a mensagem.

2. **Nunca ler o corpo.** A mensagem chega inteira na entrada padrão, e o que
   este script faz com ela é descartá-la. O endereço vem por argumento, do Sieve.
   Isso não é economia de código: é o que torna verdadeira a afirmação de que a
   plataforma não sabe de quem nem sobre o que é o e-mail que gerou o aviso. O
   script é curto porque o que ele não sabe é parte do desenho.

3. **Ser rápido.** O Dovecot espera por ele antes de concluir a entrega. O prazo
   da chamada é curto de propósito; estourá-lo custa só o aviso.

O recado também é desligável sem redeploy: sem `ESTELAZ_PUSH_URL` ou sem
`ESTELAZ_PUSH_TOKEN` no ambiente, o script sai calado.
"""

import json
import os
import sys
import urllib.error
import urllib.request

# Prazo curto: o Dovecot está esperando. Dois segundos é o bastante para uma
# chamada ao vizinho de rede e pouco o bastante para não ser sentido na entrega.
PRAZO_EM_SEGUNDOS = float(os.environ.get("ESTELAZ_PUSH_TIMEOUT", "2"))

CAMINHO = "/hooks/push/entrega"


def registra(mensagem):
    """Escreve no stderr, que o Dovecot recolhe para o log de e-mail.

    É o único canal de diagnóstico que não exige um arquivo novo com permissão
    nova dentro do contêiner.
    """
    try:
        sys.stderr.write("estelaz-avisa-push: {}\n".format(mensagem))
    except Exception:
        pass


def avisa(base, token, endereco, pasta):
    corpo = {"address": endereco}
    if pasta:
        corpo["folder"] = pasta

    pedido = urllib.request.Request(
        base.rstrip("/") + CAMINHO,
        data=json.dumps(corpo).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Authorization": "Bearer {}".format(token),
        },
        method="POST",
    )

    with urllib.request.urlopen(pedido, timeout=PRAZO_EM_SEGUNDOS) as resposta:
        # A plataforma responde 202 e sucesso mesmo quando não havia aparelho a
        # avisar. Ler o status serve só para o log.
        if resposta.status >= 300:
            registra("a plataforma respondeu {}".format(resposta.status))


def main():
    base = os.environ.get("ESTELAZ_PUSH_URL", "").strip()
    token = os.environ.get("ESTELAZ_PUSH_TOKEN", "").strip()

    if not base or not token:
        # Push não configurado nesta instalação: nada a fazer, e nada a registrar
        # — um aviso por mensagem entregue encheria o log sem informar nada.
        return

    # O Sieve passa o endereço como primeiro argumento e a pasta como segundo.
    endereco = (sys.argv[1] if len(sys.argv) > 1 else "").strip().lower()
    pasta = (sys.argv[2] if len(sys.argv) > 2 else "").strip()

    if not endereco or "@" not in endereco:
        registra("sem endereço utilizável; nada enviado")
        return

    try:
        avisa(base, token, endereco, pasta)
    except urllib.error.HTTPError as erro:
        registra("a plataforma recusou: {} {}".format(erro.code, erro.reason))
    except Exception as erro:
        registra("não deu para avisar: {}".format(erro))


if __name__ == "__main__":
    try:
        main()
    finally:
        # A mensagem chega inteira na entrada padrão e é descartada sem ser lida.
        # Drenar o que sobrou evita um "broken pipe" no log do Dovecot quando ele
        # ainda está escrevendo e o script já acabou.
        try:
            while sys.stdin.buffer.read(65536):
                pass
        except Exception:
            pass

    # Sempre 0. Ver a regra 1 no topo deste arquivo.
    sys.exit(0)
