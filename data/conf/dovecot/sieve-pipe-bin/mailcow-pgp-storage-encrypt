#!/usr/bin/env python3
import email
import email.utils
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import datetime
from email.message import EmailMessage
from email.policy import SMTP

# Signals to the storage plugin that encryption was wanted but did not happen,
# so it can apply the mailbox's failure mode instead of assuming success.
EXIT_NOT_ENCRYPTED = 75

DEFAULT_DEBUG_LOG = "/var/log/mailcow-pgp-storage-debug.log"
MAX_LOG_SIZE = 1048576  # 1MB
LOG_BACKUP_COUNT = 5

def get_debug_config():
    debug_enabled = os.environ.get("PGP_STORAGE_DEBUG", "1") not in ("0", "no", "false", "no", "")
    debug_log = os.environ.get("PGP_STORAGE_DEBUG_LOG", DEFAULT_DEBUG_LOG)
    return debug_enabled, debug_log

def rotate_log(log_path):
    try:
        if not os.path.exists(log_path):
            return
        if os.path.getsize(log_path) > MAX_LOG_SIZE:
            for i in range(LOG_BACKUP_COUNT - 1, 0, -1):
                src = log_path + ".{}".format(i)
                dst = log_path + ".{}".format(i + 1)
                if os.path.exists(src):
                    shutil.move(src, dst)
            shutil.move(log_path, log_path + ".1")
    except Exception:
        pass

def log_debug(msg):
    debug_enabled, debug_log = get_debug_config()
    if not debug_enabled:
        return
    try:
        rotate_log(debug_log)
        with open(debug_log, "a") as f:
            timestamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")
            f.write("{} {}\n".format(timestamp, msg))
    except Exception:
        pass

def emit(data):
    sys.stdout.buffer.write(data)

def get_argv_recipients():
    recipients = []
    for arg in sys.argv[1:]:
        match = re.search(r"[\w.!#$%&'*+/=?^_`{|}~-]+@[\w.-]+", arg)
        if match:
            recipients.append(match.group(0).lower())
    return recipients

def candidates_from_env():
    env_recipients = []
    for name in ("PGP_STORAGE_RECIPIENT", "USER", "USERNAME", "RECIPIENT",
                 "ORIG_RECIPIENT", "SIEVE_USER", "DELIVERED_TO"):
        value = os.environ.get(name, "")
        match = re.search(r"[\w.!#$%&'*+/=?^_`{|}~-]+@[\w.-]+", value)
        if match:
            env_recipients.append(match.group(0).lower())
    return env_recipients

def candidates_from_headers(message):
    header_recipients = []
    for name in ("X-Original-To", "Delivered-To", "Envelope-To", "To", "From"):
        for value in message.get_all(name, []):
            for _, addr in email.utils.getaddresses([value]):
                if addr and "@" in addr:
                    header_recipients.append(addr.lower())
    return header_recipients

DB_CONFIG_FILES = (
    "/etc/dovecot/sql/dovecot-dict-sql-userdb.conf",
    "/etc/dovecot/sql/dovecot-dict-sql-quota.conf",
)

def db_credentials():
    dbname = os.environ.get("DBNAME")
    dbuser = os.environ.get("DBUSER")
    dbpass = os.environ.get("DBPASS")
    if dbname and dbuser and dbpass:
        return dbname, dbuser, dbpass

    # Dovecot's master process sanitises the environment of its service
    # processes, so DBNAME/DBUSER/DBPASS do not survive into an LMTP or IMAP
    # worker unless they are listed in import_environment. Fall back to the
    # connect string mailcow writes for the SQL userdb.
    for path in DB_CONFIG_FILES:
        try:
            with open(path) as handle:
                for line in handle:
                    if not line.lstrip().startswith("connect"):
                        continue
                    fields = dict(re.findall(r'(\w+)=([^\s"]+)', line))
                    if fields.get("dbname") and fields.get("user") and fields.get("password"):
                        log_debug("db_credentials: using connect string from " + path)
                        return fields["dbname"], fields["user"], fields["password"]
        except OSError:
            continue
    return None, None, None

def load_public_key(candidates):
    # The storage plugin hands the key over directly, so the common path needs
    # no database access at all. The DB lookup below only matters if this is
    # invoked some other way.
    env_key = os.environ.get("PGP_PUBLIC_KEY", "").strip()
    if env_key:
        hide = os.environ.get("PGP_ENCRYPT_SUBJECT", "0") == "1"
        log_debug("load_public_key: using key from environment, key_len=" + str(len(env_key)))
        return env_key, hide

    try:
        import MySQLdb
    except ImportError:
        log_debug("load_public_key: MySQLdb not available")
        return None, False

    dbname, dbuser, dbpass = db_credentials()
    if not dbname or not dbuser or not dbpass:
        log_debug("load_public_key: no DB credentials from env or mailcow SQL config")
        return None, False

    seen = []
    for candidate in candidates:
        if candidate not in seen:
            seen.append(candidate)
    if not seen:
        log_debug("load_public_key: no candidates")
        return None, False

    log_debug("load_public_key: trying candidates: " + ", ".join(seen))
    try:
        conn = MySQLdb.connect(
            unix_socket="/var/run/mysqld/mysqld.sock",
            user=dbuser,
            passwd=dbpass,
            db=dbname,
            charset="utf8mb4",
        )
    except MySQLdb.Error as e:
        log_debug("load_public_key: MySQL connection error: " + str(e))
        return None, False
    try:
        cur = conn.cursor(MySQLdb.cursors.DictCursor)
        for candidate in seen:
            cur.execute(
                "SELECT attributes FROM mailbox WHERE username = %s AND active IN ('1', '2')",
                (candidate,),
            )
            row = cur.fetchone()
            if not row:
                log_debug("load_public_key: no row for " + candidate)
                continue
            attrs = json.loads(row.get("attributes") or "{}")
            pgp_encrypt = str(attrs.get("pgp_storage_encrypt", "0"))
            pgp_key = attrs.get("pgp_public_key")
            log_debug("load_public_key: " + candidate + " pgp_storage_encrypt=" + pgp_encrypt + " has_key=" + str(bool(pgp_key)))
            if pgp_encrypt == "1" and pgp_key:
                hide = str(attrs.get("pgp_encrypt_subject", "0")) == "1"
                log_debug("load_public_key: found key for " + candidate +
                          " key_len=" + str(len(pgp_key)) +
                          " encrypt_subject=" + str(hide))
                return pgp_key, hide
    except Exception as e:
        log_debug("load_public_key: error: " + str(e))
    finally:
        conn.close()
    log_debug("load_public_key: no matching key found")
    return None, False

def normalize_armor(public_key):
    """Make a pasted armored key acceptable to gpg.

    OpenPGP armor needs an empty line between the BEGIN line and the base64
    body. Keys pasted through the UI routinely lose it; gpg then reports
    "invalid armor header" and exits non-zero even though it imported the key
    perfectly well.
    """
    text = public_key.replace("\r\n", "\n").replace("\r", "\n").strip()
    lines = text.split("\n")
    if not lines or not lines[0].startswith("-----BEGIN PGP"):
        return text + "\n"
    # An armor header is "Name: value"; base64 never contains a colon.
    if len(lines) > 1 and lines[1].strip() and ":" not in lines[1]:
        lines.insert(1, "")
        log_debug("normalize_armor: inserted the blank line missing after the armor header")
    return "\n".join(lines) + "\n"

def import_key(gnupghome, public_key):
    try:
        proc = subprocess.run(
            ["gpg", "--batch", "--homedir", gnupghome, "--import"],
            input=public_key.encode(),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
        )
    except FileNotFoundError:
        log_debug("import_key: gpg not found in PATH")
        return None
    if proc.returncode != 0:
        # gpg exits non-zero on armor warnings even when the key imported
        # fine, so whether a fingerprint shows up below decides this, not the
        # exit code.
        log_debug("import_key: gpg exited {}: {}".format(
            proc.returncode,
            proc.stderr.decode(errors="replace").strip().replace("\n", " | ")))

    try:
        proc = subprocess.run(
            ["gpg", "--batch", "--homedir", gnupghome, "--with-colons", "--list-keys"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        return None
    if proc.returncode != 0:
        return None

    for line in proc.stdout.decode(errors="ignore").splitlines():
        fields = line.split(":")
        if fields[0] == "fpr" and len(fields) > 9 and fields[9]:
            return fields[9]
    log_debug("import_key: keyring is empty after import")
    return None

def encrypt_with_sq(original, public_key):
    """Encrypt with sequoia, which is what Stalwart uses.

    Unlike gpg, sequoia does not switch to AEAD/OCB just because the recipient
    key advertises support for it, so the result stays readable by clients
    built on older OpenPGP stacks. It also takes the certificate as a file,
    so no keyring or fingerprint lookup is needed.
    """
    workdir = tempfile.mkdtemp(prefix="mailcow-pgp-sq-")
    try:
        os.chmod(workdir, 0o700)
        keyfile = os.path.join(workdir, "recipient.asc")
        with open(keyfile, "w") as handle:
            handle.write(public_key)

        env = dict(os.environ)
        # sq wants somewhere to put its state; the filter runs with a stripped
        # environment and usually has no HOME.
        env.setdefault("HOME", workdir)
        try:
            proc = subprocess.run(
                ["sq", "encrypt", "--for-file", keyfile],
                input=original,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=env,
            )
        except FileNotFoundError:
            log_debug("encrypt_with_sq: sq not installed")
            return None
        if proc.returncode != 0:
            log_debug("encrypt_with_sq: sq exited {}: {}".format(
                proc.returncode,
                proc.stderr.decode(errors="replace").strip().replace("\n", " | ")))
            return None
        if not proc.stdout.startswith(b"-----BEGIN PGP MESSAGE-----"):
            log_debug("encrypt_with_sq: unexpected output from sq")
            return None
        log_debug("encrypt_with_sq: ok, {} bytes".format(len(proc.stdout)))
        return proc.stdout
    finally:
        shutil.rmtree(workdir, ignore_errors=True)

def encrypt_with_gpg(original, public_key):
    gnupghome = tempfile.mkdtemp(prefix="mailcow-pgp-")
    try:
        os.chmod(gnupghome, 0o700)
        fingerprint = import_key(gnupghome, public_key)
        if not fingerprint:
            log_debug("encrypt_with_gpg: could not get fingerprint")
            return None
        try:
            proc = subprocess.run(
                [
                    "gpg",
                    "--batch",
                    "--yes",
                    "--trust-model",
                    "always",
                    "--homedir",
                    gnupghome,
                    "--armor",
                    "--encrypt",
                    "--recipient",
                    fingerprint,
                ],
                input=original,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
        except FileNotFoundError:
            log_debug("encrypt_with_gpg: gpg not installed")
            return None
        if proc.returncode != 0:
            log_debug("encrypt_with_gpg: gpg exited {}: {}".format(
                proc.returncode,
                proc.stderr.decode(errors="replace").strip().replace("\n", " | ")))
            return None
        return proc.stdout
    finally:
        shutil.rmtree(gnupghome, ignore_errors=True)

def encrypt(original, public_key):
    armored = normalize_armor(public_key)
    encrypted = encrypt_with_sq(original, armored)
    if encrypted:
        return encrypted
    log_debug("encrypt: falling back to gpg")
    return encrypt_with_gpg(original, armored)

HIDDEN_SUBJECT = "[...]"

def mark_protected_headers(raw):
    """Tag the payload so clients know its headers are the authoritative ones.

    draft-autocrypt-lamps-protected-headers, which Thunderbird implements,
    requires protected-headers="v1" on the Content-Type of the cryptographic
    payload. Without it a client decrypts fine but still shows the obscured
    outer subject, because nothing tells it to look inside.

    Edited textually on the header block alone: re-serialising through the
    email module would rewrite headers and MIME structure across every message
    that passes through here.
    """
    for sep in (b"\r\n\r\n", b"\n\n"):
        idx = raw.find(sep)
        if idx != -1:
            head, body, eol = raw[:idx], raw[idx + len(sep):], sep[:len(sep) // 2]
            break
    else:
        head, body, eol = raw, b"", b"\n"

    lines = head.split(eol)
    out = []
    found = False
    i = 0
    while i < len(lines):
        line = lines[i]
        if not found and line[:13].lower() == b"content-type:":
            # Take the folded header whole before touching it.
            block = [line]
            i += 1
            while i < len(lines) and lines[i][:1] in (b" ", b"\t"):
                block.append(lines[i])
                i += 1
            joined = eol.join(block)
            if b"protected-headers" not in joined.lower():
                joined = joined.rstrip() + b'; protected-headers="v1"'
            out.append(joined)
            found = True
            continue
        out.append(line)
        i += 1

    if not found:
        # No Content-Type means text/plain us-ascii; state it so the parameter
        # has somewhere to live.
        out.insert(0, b'Content-Type: text/plain; charset="us-ascii"; '
                      b'protected-headers="v1"')

    return eol.join(out) + sep + body



def pgp_mime(original, encrypted, hide_subject=False):
    source = email.message_from_bytes(original, policy=SMTP)
    outer = EmailMessage(policy=SMTP)
    # The real subject travels inside the encrypted payload either way; this
    # only decides whether a copy also stays readable on the outside.
    headers = ("From", "To", "Cc", "Date", "Message-ID") if hide_subject else \
              ("From", "To", "Cc", "Date", "Subject", "Message-ID")
    for name in headers:
        if source.get(name):
            outer[name] = source[name]
    if hide_subject:
        outer["Subject"] = HIDDEN_SUBJECT
    outer["X-Mailcow-PGP-Storage"] = "encrypted"
    outer.set_type("multipart/encrypted")
    outer.set_param("protocol", "application/pgp-encrypted")

    control = EmailMessage(policy=SMTP)
    control.set_content("Version: 1\n", subtype="pgp-encrypted")
    control.replace_header("Content-Type", "application/pgp-encrypted")

    payload = EmailMessage(policy=SMTP)
    payload.set_content(encrypted.decode("ascii", errors="ignore"))
    payload.replace_header("Content-Type", "application/octet-stream; name=\"encrypted.asc\"")
    payload["Content-Disposition"] = "inline; filename=\"encrypted.asc\""

    outer.attach(control)
    outer.attach(payload)
    return outer.as_bytes()

def main():
    original = sys.stdin.buffer.read()
    parsed = email.message_from_bytes(original, policy=SMTP)

    # Already protected: passing it through unchanged is a success, not a
    # failure to encrypt.
    if parsed.get("X-Mailcow-PGP-Storage") == "encrypted":
        emit(original)
        return 0
    if parsed.get_content_type().lower() == "multipart/encrypted":
        emit(original)
        return 0
    if b"-----BEGIN PGP MESSAGE-----" in original[:4096]:
        emit(original)
        return 0

    argv_recipients = get_argv_recipients()
    env_recipients = candidates_from_env()
    header_recipients = candidates_from_headers(parsed)

    all_candidates = argv_recipients + env_recipients + header_recipients

    log_debug("=== PGP Storage Filter ===")
    log_debug("argv recipients: " + ", ".join(argv_recipients) if argv_recipients else "argv recipients: none")
    log_debug("env recipients: " + ", ".join(env_recipients) if env_recipients else "env recipients: none")
    log_debug("header recipients: " + ", ".join(header_recipients) if header_recipients else "header recipients: none")
    log_debug("all candidates: " + ", ".join(all_candidates) if all_candidates else "all candidates: none")

    try:
        public_key, hide_subject = load_public_key(all_candidates)
        if not public_key:
            log_debug("No public key found for any candidate")
            emit(original)
            return EXIT_NOT_ENCRYPTED
        # Only messages whose subject is being hidden need the marker, so
        # everyone else keeps a payload identical to what arrived.
        payload = mark_protected_headers(original) if hide_subject else original
        encrypted = encrypt(payload, public_key)
        if encrypted:
            emit(pgp_mime(original, encrypted, hide_subject))
            log_debug("Encryption successful for key_len=" + str(len(public_key)))
            return 0
        log_debug("Encryption returned None, emitting original")
        emit(original)
        return EXIT_NOT_ENCRYPTED
    except Exception as e:
        log_debug("Exception: " + str(e))
        emit(original)
        return EXIT_NOT_ENCRYPTED

if __name__ == "__main__":
    sys.exit(main())
