<div class="tab-pane fade" id="tab-user-settings" role="tabpanel" aria-labelledby="tab-user-settings">
  <div class="card mb-4">
    <div class="card-header d-flex fs-5">
      <button class="btn d-md-none flex-grow-1 text-start" data-bs-target="#collapse-tab-user-settings" data-bs-toggle="collapse" aria-controls="collapse-tab-user-settings">
        {{ lang.user.mailbox_settings }}
      </button>
      <span class="d-none d-md-block">{{ lang.user.mailbox_settings }}</span>
    </div>
    <div id="collapse-tab-user-settings" class="card-body collapse" data-bs-parent="#user-content">
      {# Show tagging options #}
      <div class="row">
        <div class="col-sm-3 col-12 text-sm-end text-start text-xs-bold mb-4">{{ lang.user.tag_handling }}:</div>
        <div class="col-sm-9 col-12">
          <div class="btn-group" data-acl="{{ acl.delimiter_action }}">
            <button type="button" class="btn btn-sm btn-xs-third d-block d-sm-inline{% if get_tagging_options == 'subfolder' %} btn-dark{% else %} btn-light{% endif %}"
            data-action="edit_selected"
            data-item="{{ mailcow_cc_username }}"
            data-id="delimiter_action"
            data-api-url='edit/delimiter_action'
            data-api-attr='{"tagged_mail_handler":"subfolder"}'>{{ lang.user.tag_in_subfolder }}</button>
            <button type="button" class="btn btn-sm btn-xs-third d-block d-sm-inline{% if get_tagging_options == 'subject' %} btn-dark{% else %} btn-light{% endif %}"
            data-action="edit_selected"
            data-item="{{ mailcow_cc_username }}"
            data-id="delimiter_action"
            data-api-url='edit/delimiter_action'
            data-api-attr='{"tagged_mail_handler":"subject"}'>{{ lang.user.tag_in_subject }}</button>
            <button type="button" class="btn btn-sm btn-xs-third d-block d-sm-inline{% if get_tagging_options == 'none' %} btn-dark{% else %} btn-light{% endif %}"
            data-action="edit_selected"
            data-item="{{ mailcow_cc_username }}"
            data-id="delimiter_action"
            data-api-url='edit/delimiter_action'
            data-api-attr='{"tagged_mail_handler":"none"}'>{{ lang.user.tag_in_none }}</button>
          </div>
          <p class="text-muted">{{ lang.user.tag_help_explain|raw }}</p>
          <p class="text-muted">{{ lang.user.tag_help_example|raw }}</p>
        </div>
      </div>
      <hr>
      {# The admin can withdraw PGP storage from a whole domain. Nothing is
         erased when they do: the settings below stay as the user left them and
         come back untouched if the domain is allowed again, so the form keeps
         showing them - read-only, under a banner saying they are not in
         effect - rather than hiding or blanking them. #}
      {% set pgp_domain_allowed = mailboxdata.domain_pgp_storage is not defined or mailboxdata.domain_pgp_storage == '1' %}
      <form data-id="pgp_storage">
        {# The switches below are read as "leave it as it is" when absent, and
           an unchecked box is not posted at all - so each one gets a zero to
           fall back on. #}
        <input type="hidden" value="0" name="pgp_storage_encrypt">
        <input type="hidden" value="0" name="pgp_encrypt_subject">
        <input type="hidden" value="0" name="pgp_skip_spam">
        <div class="row">
          <div class="col-sm-3 col-12 text-sm-end text-start text-xs-bold mb-4">{{ lang.user.pgp_storage }}:</div>
          <div class="col-sm-9 col-12">
            {% if not pgp_domain_allowed %}
            <div class="alert alert-warning py-2">{{ lang.user.pgp_domain_disabled }}</div>
            {% endif %}
            <div class="form-check form-switch mb-2">
              <input class="form-check-input" type="checkbox" role="switch" id="pgp_storage_encrypt" name="pgp_storage_encrypt" value="1"{% if mailboxdata.attributes.pgp_storage_encrypt == '1' or mailboxdata.attributes.pgp_storage_encrypt == 1 %} checked{% endif %}{% if not pgp_domain_allowed %} disabled{% endif %}>
              <label class="form-check-label" for="pgp_storage_encrypt">{{ lang.user.pgp_storage_enable }}</label>
            </div>
            <textarea class="form-control" id="pgp_public_key" rows="8" name="pgp_public_key" spellcheck="false"{% if not pgp_domain_allowed %} readonly{% endif %} placeholder="-----BEGIN PGP PUBLIC KEY BLOCK-----">{{ mailboxdata.attributes.pgp_public_key|default('') }}</textarea>
            <div id="pgp_key_feedback" class="small mt-1"></div>
            <div class="mt-2 mb-2">
              <button type="button" class="btn btn-sm btn-secondary" id="pgp_key_file_btn"{% if not pgp_domain_allowed %} disabled{% endif %}><i class="bi bi-upload"></i> {{ lang.user.pgp_key_load_file }}</button>
              <button type="button" class="btn btn-sm btn-secondary" id="pgp_key_clear_btn"{% if not pgp_domain_allowed %} disabled{% endif %}><i class="bi bi-x-lg"></i> {{ lang.user.pgp_key_clear }}</button>
              <span id="pgp_key_filename" class="text-muted small ms-2"></span>
            </div>
            <div class="border-start ps-3 mt-3 mb-2" id="pgp_suboptions">
              <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" role="switch" id="pgp_encrypt_subject" name="pgp_encrypt_subject" value="1"{% if mailboxdata.attributes.pgp_encrypt_subject == '1' or mailboxdata.attributes.pgp_encrypt_subject == 1 %} checked{% endif %}{% if not pgp_domain_allowed %} disabled{% endif %}>
                <label class="form-check-label" for="pgp_encrypt_subject">{{ lang.user.pgp_encrypt_subject }}</label>
                <div class="text-muted small">{{ lang.user.pgp_encrypt_subject_help }}</div>
              </div>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="pgp_skip_spam" name="pgp_skip_spam" value="1"{% if mailboxdata.attributes.pgp_skip_spam == '1' or mailboxdata.attributes.pgp_skip_spam == 1 %} checked{% endif %}{% if not pgp_domain_allowed %} disabled{% endif %}>
                <label class="form-check-label" for="pgp_skip_spam">{{ lang.user.pgp_skip_spam }}</label>
                <div class="text-muted small">{{ lang.user.pgp_skip_spam_help }}</div>
              </div>
              <div class="mt-3">
                <label class="form-label mb-1" for="pgp_failure_mode">{{ lang.user.pgp_failure_mode }}:</label>
                <select class="form-select form-select-sm" id="pgp_failure_mode" name="pgp_failure_mode" style="max-width:32rem"{% if not pgp_domain_allowed %} disabled{% endif %}>
                  <option value="deliver"{% if mailboxdata.attributes.pgp_failure_mode|default('deliver') == 'deliver' %} selected{% endif %}>{{ lang.user.pgp_failure_deliver }}</option>
                  <option value="defer"{% if mailboxdata.attributes.pgp_failure_mode|default('deliver') == 'defer' %} selected{% endif %}>{{ lang.user.pgp_failure_defer }}</option>
                </select>
                <div class="text-muted small mt-1">{{ lang.user.pgp_failure_mode_help }}</div>
              </div>
            </div>
            <p class="text-muted">{{ lang.user.pgp_storage_help }}</p>
            <button type="button" class="btn btn-sm btn-success" id="pgp_storage_save" data-action="edit_selected" data-item="{{ mailcow_cc_username }}" data-id="pgp_storage" data-api-url='edit/pgp-storage' data-api-attr='{}'{% if not pgp_domain_allowed %} disabled{% endif %}><i class="bi bi-check-lg"></i> {{ lang.user.save_changes }}</button>
          </div>
        </div>
      </form>
      {# Kept outside the form: edit_selected serialises every input it finds,
         and the file picker only ever feeds the textarea. #}
      <input type="file" id="pgp_key_file" accept=".asc,.gpg,.pgp,.key,.txt,text/plain" style="display:none">
      <script>
      (function () {
        var msg = {
          isPrivate:    {{ lang.user.pgp_js_private|json_encode|raw }},
          notArmored:   {{ lang.user.pgp_js_not_armored|json_encode|raw }},
          badBase64:    {{ lang.user.pgp_js_bad_base64|json_encode|raw }},
          badChecksum:  {{ lang.user.pgp_js_bad_checksum|json_encode|raw }},
          notPacket:    {{ lang.user.pgp_js_not_packet|json_encode|raw }},
          notPublicKey: {{ lang.user.pgp_js_not_public_key|json_encode|raw }},
          valid:        {{ lang.user.pgp_js_valid|json_encode|raw }},
          fileTooLarge: {{ lang.user.pgp_js_file_too_large|json_encode|raw }},
          unreadable:   {{ lang.user.pgp_js_file_unreadable|json_encode|raw }},
          keyRequired:  {{ lang.user.pgp_js_key_required|json_encode|raw }}
        };
        var ta = document.getElementById('pgp_public_key');
        if (!ta) { return; }
        var feedback = document.getElementById('pgp_key_feedback');
        var fileInput = document.getElementById('pgp_key_file');
        var filename = document.getElementById('pgp_key_filename');
        var toggle = document.getElementById('pgp_storage_encrypt');
        var saveBtn = document.getElementById('pgp_storage_save');
        var MAX_BYTES = 128 * 1024;

        function crc24(data) {
          var crc = 0xB704CE;
          for (var i = 0; i < data.length; i++) {
            crc ^= (data.charCodeAt(i) & 0xFF) << 16;
            for (var j = 0; j < 8; j++) {
              crc <<= 1;
              if (crc & 0x1000000) { crc ^= 0x1864CFB; }
            }
          }
          return crc & 0xFFFFFF;
        }

        // Mirrors pgp_validate_public_key() in functions.mailbox.inc.php.
        function validate(text) {
          text = (text || '').replace(/\r\n?/g, '\n').trim();
          if (text === '') { return { ok: null, msg: '' }; }
          if (/PRIVATE KEY BLOCK/i.test(text)) {
            return { ok: false, msg: msg.isPrivate };
          }
          var m = text.match(/^-----BEGIN PGP PUBLIC KEY BLOCK-----\n([\s\S]*)\n-----END PGP PUBLIC KEY BLOCK-----$/);
          if (!m) {
            return { ok: false, msg: msg.notArmored };
          }
          var b64 = '', crc = null, inHeaders = true;
          m[1].split('\n').forEach(function (line) {
            line = line.trim();
            if (inHeaders) {
              if (line === '') { inHeaders = false; return; }
              if (line.indexOf(':') !== -1) { return; }
              inHeaders = false;
            }
            if (line === '') { return; }
            if (line.charAt(0) === '=') { crc = line.slice(1); return; }
            b64 += line;
          });
          if (b64.length < 24 || !/^[A-Za-z0-9+/]+={0,2}$/.test(b64)) {
            return { ok: false, msg: msg.badBase64 };
          }
          var bin;
          try { bin = atob(b64); } catch (e) {
            return { ok: false, msg: msg.badBase64 };
          }
          if (crc !== null) {
            var crcBin;
            try { crcBin = atob(crc); } catch (e) { crcBin = ''; }
            if (crcBin.length !== 3) {
              return { ok: false, msg: msg.badChecksum };
            }
            var expected = (crcBin.charCodeAt(0) << 16) | (crcBin.charCodeAt(1) << 8) | crcBin.charCodeAt(2);
            if (crc24(bin) !== expected) {
              return { ok: false, msg: msg.badChecksum };
            }
          }
          var tag = bin.charCodeAt(0);
          if (!(tag & 0x80)) {
            return { ok: false, msg: msg.notPacket };
          }
          var packet = ((tag & 0xC0) === 0xC0) ? (tag & 0x3F) : ((tag >> 2) & 0x0F);
          if (packet !== 6) {
            return { ok: false, msg: msg.notPublicKey };
          }
          return { ok: true, msg: msg.valid.replace('%s', bin.length) };
        }

        function render() {
          var result = validate(ta.value);
          ta.classList.remove('is-valid', 'is-invalid');
          feedback.className = 'small mt-1';
          if (result.ok === null) { feedback.textContent = ''; return result; }
          ta.classList.add(result.ok ? 'is-valid' : 'is-invalid');
          feedback.classList.add(result.ok ? 'text-success' : 'text-danger');
          feedback.textContent = result.msg;
          return result;
        }

        var subOptions = document.getElementById('pgp_suboptions');
        function syncSubOptions() {
          var on = toggle.checked;
          subOptions.classList.toggle('opacity-50', !on);
          subOptions.querySelectorAll('input').forEach(function (input) {
            input.disabled = !on;
          });
        }
        toggle.addEventListener('change', syncSubOptions);
        syncSubOptions();

        ta.addEventListener('input', render);
        ta.addEventListener('blur', render);

        document.getElementById('pgp_key_file_btn').addEventListener('click', function () {
          fileInput.click();
        });
        document.getElementById('pgp_key_clear_btn').addEventListener('click', function () {
          ta.value = '';
          filename.textContent = '';
          render();
        });

        fileInput.addEventListener('change', function () {
          var file = this.files && this.files[0];
          this.value = '';
          if (!file) { return; }
          if (file.size > MAX_BYTES) {
            ta.classList.add('is-invalid');
            feedback.className = 'small mt-1 text-danger';
            feedback.textContent = msg.fileTooLarge;
            return;
          }
          var reader = new FileReader();
          reader.onerror = function () {
            feedback.className = 'small mt-1 text-danger';
            feedback.textContent = msg.unreadable;
          };
          reader.onload = function () {
            ta.value = String(reader.result).replace(/\r\n?/g, '\n').trim() + '\n';
            filename.textContent = file.name;
            render();
          };
          reader.readAsText(file);
        });

        // Bound on the button in the capture phase so it runs before mailcow's
        // delegated edit_selected handler on document, and can stop it.
        saveBtn.addEventListener('click', function (e) {
          var result = render();
          if (toggle.checked && result.ok !== true) {
            e.preventDefault();
            e.stopPropagation();
            if (result.ok === null) {
              ta.classList.add('is-invalid');
              feedback.className = 'small mt-1 text-danger';
              feedback.textContent = msg.keyRequired;
            }
          }
        }, true);

        render();
      })();
      </script>
      {# Show TLS policy options #}
      <div class="row">
        <div class="col-sm-3 col-12 text-sm-end text-start text-xs-bold mb-4">{{ lang.user.tls_policy }}:</div>
        <div class="col-sm-9 col-12">
          <div class="btn-group" data-acl="{{ acl.tls_policy }}">
            <button type="button" class="btn btn-sm btn-xs-half d-block d-sm-inline{% if get_tls_policy.tls_enforce_in == '1' %} btn-dark"{% else %} btn-light{% endif %}"
            data-action="edit_selected"
            data-item="{{ mailcow_cc_username }}"
            data-id="tls_policy"
            data-api-url='edit/tls_policy'
            data-api-attr='{"tls_enforce_in": {% if get_tls_policy.tls_enforce_in == '1' %}0{% else %}1{% endif %} }'>{{ lang.user.tls_enforce_in }}</button>
            <button type="button" class="btn btn-sm btn-xs-half d-block d-sm-inline{% if get_tls_policy.tls_enforce_out == '1' %} btn-dark{% else %} btn-light{% endif %}"
            data-action="edit_selected"
            data-item="{{ mailcow_cc_username }}"
            data-id="tls_policy"
            data-api-url='edit/tls_policy'
            data-api-attr='{"tls_enforce_out": {% if get_tls_policy.tls_enforce_out == '1' %}0{% else %}1{% endif %} }'>{{ lang.user.tls_enforce_out }}</button>
          </div>
          <p class="text-muted">{{ lang.user.tls_policy_warning|raw }}</p>
        </div>
      </div>
      {# Show quarantine_notification options #}
      <div class="row">
        <div class="col-sm-3 col-12 text-sm-end text-start text-xs-bold mb-4">{{ lang.user.quarantine_notification }}:</div>
        <div class="col-sm-9 col-12">
          <div class="btn-group" data-acl="{{ acl.quarantine_notification }}">
            <button type="button" class="btn btn-sm btn-xs-quart d-block d-sm-inline{% if quarantine_notification == 'never' %} btn-dark{% else %} btn-light{% endif %}"
            data-action="edit_selected"
            data-item="{{ mailcow_cc_username }}"
            data-id="quarantine_notification"
            data-api-url='edit/quarantine_notification'
            data-api-attr='{"quarantine_notification":"never"}'>{{ lang.user.never }}</button>
            <button type="button" class="btn btn-sm btn-xs-quart d-block d-sm-inline{% if quarantine_notification == 'hourly' %} btn-dark{% else %} btn-light{% endif %}"
            data-action="edit_selected"
            data-item="{{ mailcow_cc_username }}"
            data-id="quarantine_notification"
            data-api-url='edit/quarantine_notification'
            data-api-attr='{"quarantine_notification":"hourly"}'>{{ lang.user.hourly }}</button>
            <button type="button" class="btn btn-sm btn-xs-quart d-block d-sm-inline{% if quarantine_notification == 'daily' %} btn-dark{% else %} btn-light{% endif %}"
            data-action="edit_selected"
            data-item="{{ mailcow_cc_username }}"
            data-id="quarantine_notification"
            data-api-url='edit/quarantine_notification'
            data-api-attr='{"quarantine_notification":"daily"}'>{{ lang.user.daily }}</button>
            <button type="button" class="btn btn-sm btn-xs-quart d-block d-sm-inline{% if quarantine_notification == 'weekly' %} btn-dark{% else %} btn-light{% endif %}"
            data-action="edit_selected"
            data-item="{{ mailcow_cc_username }}"
            data-id="quarantine_notification"
            data-api-url='edit/quarantine_notification'
            data-api-attr='{"quarantine_notification":"weekly"}'>{{ lang.user.weekly }}</button>
          </div>
          <p class="text-muted">{{ lang.user.quarantine_notification_info }}</p>
        </div>
      </div>
      <div class="row">
        <div class="col-sm-3 col-12 text-sm-end text-start text-xs-bold mb-4">{{ lang.user.quarantine_category }}:</div>
        <div class="col-sm-9 col-12">
          <div class="btn-group" data-acl="{{ acl.quarantine_category }}">
            <button type="button" class="btn btn-sm btn-xs-third d-block d-sm-inline{% if quarantine_category == 'reject' %} btn-dark{% else %} btn-light{% endif %}"
            data-action="edit_selected"
            data-item="{{ mailcow_cc_username }}"
            data-id="quarantine_category"
            data-api-url='edit/quarantine_category'
            data-api-attr='{"quarantine_category":"reject"}'>{{ lang.user.q_reject }}</button>
            <button type="button" class="btn btn-sm btn-xs-third d-block d-sm-inline{% if quarantine_category == 'add_header' %} btn-dark{% else %} btn-light{% endif %}"
            data-action="edit_selected"
            data-item="{{ mailcow_cc_username }}"
            data-id="quarantine_category"
            data-api-url='edit/quarantine_category'
            data-api-attr='{"quarantine_category":"add_header"}'>{{ lang.user.q_add_header }}</button>
            <button type="button" class="btn btn-sm btn-xs-third d-block d-sm-inline{% if quarantine_category == 'all' %} btn-dark{% else %} btn-light{% endif %}"
            data-action="edit_selected"
            data-item="{{ mailcow_cc_username }}"
            data-id="quarantine_category"
            data-api-url='edit/quarantine_category'
            data-api-attr='{"quarantine_category":"all"}'>{{ lang.user.q_all }}</button>
          </div>
          <p class="text-muted">{{ lang.user.quarantine_category_info }}</p>
        </div>
      </div>
      {% if not skip_sogo %}
      <hr>
      <div class="row">
        <div class="col-sm-3 col-12 text-sm-end text-start text-xs-bold mb-4">{{ lang.user.eas_reset }}:</div>
        <div class="col-sm-9 col-12">
          <button class="btn btn-sm d-block d-sm-inline btn-secondary" data-acl="{{ acl.eas_reset }}" data-action="delete_selected" data-text="{{ lang.user.eas_reset }}?" data-item="{{ mailcow_cc_username }}" data-id="eas_cache" data-api-url='delete/eas_cache' href="#">{{ lang.user.eas_reset_now }}</button>
          <p class="text-muted">{{ lang.user.eas_reset_help|raw }}</p>
        </div>
      </div>
      <div class="row">
        <div class="col-sm-3 col-12 text-sm-end text-start text-xs-bold mb-4">{{ lang.user.sogo_profile_reset }}:</div>
        <div class="col-sm-9 col-12">
          <button class="btn btn-sm d-block d-sm-inline btn-secondary" data-acl="{{ acl.sogo_profile_reset }}" data-action="delete_selected" data-text="{{ lang.user.sogo_profile_reset }}?" data-item="{{ mailcow_cc_username }}" data-id="sogo_profile" data-api-url='delete/sogo_profile' href="#">{{ lang.user.sogo_profile_reset_now }}</button>
          <p class="text-muted">{{ lang.user.sogo_profile_reset_help|raw }}</p>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</div>
