{# The address was given in the first step, so only the password is asked for
   here. Whether it is checked against mailcow, LDAP or Keycloak follows from
   the mailbox itself - check_login decides that, not this form. #}
<form method="post" autofill="off" class="w-100">
  <input type="hidden" name="login_user" value="{{ login_identify }}" autocomplete="username">
  <div class="d-flex mt-3">
    <label class="visually-hidden" for="pass_user">{{ lang.login.password }}</label>
    <div class="input-group">
      <div class="input-group-text"><i class="bi bi-lock-fill"></i></div>
      <input name="pass_user" type="password" id="pass_user" class="form-control" placeholder="{{ lang.login.password }}" required="" {% if pw_primary %}autofocus=""{% endif %} autocomplete="current-password">
    </div>
  </div>
  <div class="mt-2 text-muted" style="font-size: 0.9rem;">
    <a href="/reset-password">{{ lang.login.forgot_password }}</a>
  </div>
  {% if captcha %}
  <div class="d-flex justify-content-center mt-3">
    <div class="{{ captcha.widget_class }}" {{ captcha.site_attr }}="{{ captcha.site_key }}"></div>
  </div>
  <script src="{{ captcha.script }}" async defer></script>
  {% endif %}
  <div class="d-flex justify-content-between mt-4" style="position: relative">
    <button type="submit" class="btn btn-xs-lg {% if pw_primary %}btn-success{% else %}btn-secondary{% endif %} w-100 mt-2 mx-auto" style="max-width: 400px;" value="Login">{{ lang.login.login }}</button>
  </div>
</form>
